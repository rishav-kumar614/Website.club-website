# Copy to .env.local (git-ignored) and fill in, then restart `npm run dev`.

# Talk page brain: answers the visitor's questions (Anthropic API)
ANTHROPIC_API_KEY=
# optional, defaults to claude-haiku-5-5
# ANTHROPIC_MODEL=

# Talk page voice: every answer is spoken in one voice (ElevenLabs)
ELEVENLABS_API_KEY=
# optional, defaults to "Viraj - Warm, Confident & Natural Customer Care Agent"
# ELEVENLABS_VOICE_ID=fPIfC3elMLbN9tNwMXkw
